# NextAuth Configuration
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth
# Create OAuth credentials at: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LLM Provider API Keys (optional for Phase 1)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Neon Postgres — pooled URL for the app, direct URL for migrations
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Comma-separated sign-in allowlist. LEAVE UNSET AND THE APP IS OPEN TO ANYONE.
ALLOWED_EMAILS=

# Chrome extension IDs allowed to call /api/v1 and receive tokens from /extension/connect.
# Comma-separated: Web Store ID, plus your unpacked dev ID.
# "*" allows any well-formed extension ID (handy in development; any extension
# can then ask a signed-in user to connect, so keep an explicit list in production).
NEXT_PUBLIC_EXTENSION_IDS=
