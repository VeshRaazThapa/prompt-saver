# NextAuth Configuration
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth
# Create OAuth credentials at: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LLM Provider API Keys (optional for Phase 1)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Neon Postgres — pooled URL for the app, direct URL for migrations
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Comma-separated sign-in allowlist. LEAVE UNSET AND THE APP IS OPEN TO ANYONE.
ALLOWED_EMAILS=
